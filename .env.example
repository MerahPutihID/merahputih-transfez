# App Configuration
APP_ENV=development
LOG_LEVEL=DEBUG
HTTP_DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SQLALCHEMY_ECHO=FALSE
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_POOL_TIMEOUT=30

# API Configuration
# Remittance: URL of BMP transaction callback service (used by scheduler, NOT for VA)
API_BASE_URL=http://test-stg01.merahputih-id.tech:8083/transaction
# This service (merahputih-transfez) public URL — Transfez will POST VA events here
GATEWAY_PUBLIC_URL=http://localhost:8001
THIRD_PARTY_API_URL=https://api.thirdparty.com
THIRD_PARTY_API_KEY=your_api_key

# Sender Information
SENDER_FIRSTNAME=John
SENDER_LASTNAME=Doe
SENDER_COUNTRY_ISO_CODE=IDN

# Compliance Information
COMPLIANCE_SOURCE_OF_FUNDS=SALARY_INCOME
COMPLIANCE_BENEFICIARY_RELATIONSHIPS=SIBLING_BROTHER_SISTER
COMPLIANCE_PURPOSE_OF_REMITTANCES=FAMILY_SUPPORT

# Transaction Settings
BALANCE_ID=7
TRANSFER_SERVICE_CODE=1  # Available options: 1-Bi-FAST, 2-SKN, 3-RTGS, 4-Smart Route
NOTES=Transaction processed via CDT Gateway

# Queue Processing Settings
QUEUE_PROCESSING_TIME_THRESHOLD_HOURS=6  # How many hours back to look for transactions

# Machine Filter Configuration
MAINTENANCE_ID=your_maintenance_uuid_here  # REQUIRED: Filter transactions by specific maintenance_id

# Transaction Splitting Settings
MAX_TRANSACTION_AMOUNT=5000000  # Maximum amount per transaction in IDR

# Fee Calculation Settings
MAX_FEE_PERCENTAGE=20  # Maximum fee as percentage of transaction amount (must be <= 100)